<resources>
    <style name="Theme.Medk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/medk_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/medk_black</item>
    </style>
    <style name="Theme.Medk.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/medk_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Medk</item>
    </style>
</resources>
