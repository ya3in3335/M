{
  "name": "medk-security-tests",
  "private": true,
  "scripts": {
    "rules": "sed \"s/__OWNER_EMAILS__/['owner@test.dev']/\" ../firestore.rules.tmpl > ../firestore.rules",
    "test": "mocha --timeout 20000 --exit rules.test.mjs",
    "emulate": "npm run rules && firebase emulators:exec --project demo-medk --config ../firebase.json --only firestore \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.24.2",
    "mocha": "^10.8.2"
  }
}
