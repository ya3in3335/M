rules_version = '2';

// MED-K — Cloud Storage security rules (deny by default).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && user().active == true; }
    function isOwner() { return active() && user().role == 'owner'; }
    function canManageProducts() {
      return isOwner() || (active() && user().role == 'staff' && user().get('perms', {}).get('manageProducts', false) == true);
    }

    // Product / section / banner images: public read, team upload (images ≤ 10 MB).
    match /catalog/{folder}/{file} {
      allow read: if true;
      allow create: if canManageProducts()
        && folder in ['products', 'sections', 'banners']
        && (folder == 'products' || isOwner())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if false;
      allow delete: if canManageProducts();
    }

    // Private chat attachments: only conversation participants (≤ 50 MB).
    match /chat/{cid}/{file} {
      function conv() { return firestore.get(/databases/(default)/documents/conversations/$(cid)).data; }
      function participant() {
        return active() && (conv().customerId == request.auth.uid
          || (user().role == 'staff' && conv().staffId == request.auth.uid) || isOwner());
      }
      allow read: if participant();
      allow create: if participant()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
      allow update, delete: if false;
    }
  }
}
